APP_NAME="Church of Pentecost Amsterdam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite is fine locally. Production must use MySQL/PostgreSQL — see DEPLOYMENT.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=church_platform
# DB_USERNAME=church_user
# DB_PASSWORD=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set to true so the session cookie is only ever sent over HTTPS.
# Leaving this unset means the cookie will also be sent over plain HTTP.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ─── Broadcasting / real-time (Laravel Reverb) ────────────────────────────────
# "reverb" + `php artisan reverb:start` gives live notifications and unread
# badges. "log" disables real-time; in-app notifications then update on reload.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=church-local
REVERB_APP_KEY=church-local-key
REVERB_APP_SECRET=church-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Front-end mirror of REVERB_* — baked into the JS bundle at BUILD time,
# so these must be correct before `npm run build`.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Cache / Queue / Filesystem ───────────────────────────────────────────────
FILESYSTEM_DISK=local
# PRODUCTION: use "redis". "sync" runs jobs inline; "database" needs a worker.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
# "log" writes mail to storage/logs instead of sending. Production MUST use a
# real transport, or password resets and notifications silently never arrive.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── YouTube sermon sync ──────────────────────────────────────────────────────
# Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key by IP ADDRESS (the server's outbound IPv4, plus its IPv6 if
# it has one) and to the YouTube Data API v3 only.
# Do NOT restrict it by HTTP referrer: the sync calls YouTube from the server,
# which sends no Referer header, so a referrer-locked key has every request
# rejected and the sync silently imports nothing. Leave blank to disable syncing.
YOUTUBE_API_KEY=

# ─── Initial admin account (read by ChurchSeeder) ─────────────────────────────
# If SEED_ADMIN_PASSWORD is blank the seeder generates a strong random password
# and prints it once. Never ship a known password to production.
SEED_ADMIN_EMAIL=admin@copamsterdam.nl
SEED_ADMIN_NAME="Church Admin"
SEED_ADMIN_PASSWORD=

# ─── Church defaults (used before an admin configures Settings) ───────────────
CHURCH_NAME="The Church of Pentecost"
CHURCH_TAGLINE="Possessing the Nations"
CHURCH_ADDRESS=
CHURCH_PHONE=
CHURCH_EMAIL=
CHURCH_PRIMARY_COLOR="#1E5AA8"
# CHURCH_FACEBOOK=
# CHURCH_INSTAGRAM=
# CHURCH_YOUTUBE=
# LIVESTREAM_URL=
